<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0a0f1e">
<title><%= site.name %> | <%= site.role.split('|')[0].trim() %></title>
<meta name="description" content="Portafolio de <%= site.name %> — <%= site.role %>">
<meta name="author" content="<%= site.name %>">
<!-- Open Graph -->
<meta property="og:type"        content="website">
<meta property="og:title"       content="<%= site.name %> — Portafolio">
<meta property="og:description" content="<%= site.role %>">
<meta property="og:locale"      content="es_EC">
<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./css/styles.css">
</head>
<body>
<header class="header">
  <nav class="nav">
    <a href="./index.html" class="brand">
      <img src="./img/avatar.jpg" alt="Avatar de <%= site.name %>" onerror="this.style.display='none'">
      <span class="brand-name"><%= site.name %></span>
    </a>
    <div class="menu">
      <a href="./index.html">Inicio</a>
      <a href="./projects.html">Proyectos</a>
      <a href="./experience.html">Experiencia</a>
      <a href="./contact.html">Contacto</a>
    </div>
  </nav>
</header>

<main><%- body %></main>

<footer class="footer">
  © <%= new Date().getFullYear() %> <%= site.name %> &nbsp;·&nbsp;
  <a href="<%= site.github %>" target="_blank" rel="noopener">GitHub</a>
  &nbsp;·&nbsp;
  <a href="<%= site.linkedin %>" target="_blank" rel="noopener">LinkedIn</a>
</footer>

<script src="./js/main.js"></script>
</body>
</html>
