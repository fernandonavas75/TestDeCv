<section class="container">
  <div class="hero">
    <div>
      <h2>Mis Proyectos</h2>
      <p>Una selección de proyectos en los que he trabajado, demostrando mis habilidades en desarrollo full-stack, machine learning y más. Cada proyecto refleja mi pasión por resolver problemas reales con tecnología.</p>
    </div>
  </div>
  <div class="grid cols-3">
    <% projects.forEach(p => { %>
      <article class="card">
        <h3><%= p.title %></h3>
        <p><%= p.description %></p>

        <div class="badges">
          <span class="badge"><%= p.role %></span>
          <% p.tags.forEach(tag => { %>
            <span class="badge"><%= tag %></span>
          <% }) %>
        </div>

        <ul>
          <% if (p.year) { %><li><strong>Año:</strong> <%= p.year %></li><% } %>
        </ul>

        <% if (p.collaborators && p.collaborators.length) { %>
          <p><strong>Colaboradores:</strong></p>
          <ul>
            <% p.collaborators.forEach(c => { %>
              <li>
                <% if (c.url) { %>
                  <a href="<%= c.url %>" target="_blank" rel="noopener">
                    <%= c.name %>
                  </a>
                <% } else { %>
                  <%= c.name %>
                <% } %>
                <% if (c.role) { %> — <em><%= c.role %></em><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <p>
          <% if (p.demo) { %><a class="btn" href="<%= p.demo %>">Ver Demo</a><% } %>
          <% if (p.repo) { %><a class="btn" href="<%= p.repo %>">Ver Código</a><% } %>
        </p>
      </article>
    <% }) %>
  </div>
</section>
